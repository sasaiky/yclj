[Unit]
Description=YCLJ public assist TLS frontend
After=network-online.target yclj-assist-signal.service
Wants=network-online.target yclj-assist-signal.service

[Service]
DynamicUser=yes
StateDirectory=yclj-assist-caddy
StateDirectoryMode=0700
Environment=XDG_DATA_HOME=/var/lib/yclj-assist-caddy
Environment=XDG_CONFIG_HOME=/var/lib/yclj-assist-caddy
EnvironmentFile=/opt/yclj-assist/tls.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/opt/yclj-assist/runtime/caddy run --config /opt/yclj-assist/Caddyfile
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=160M

[Install]
WantedBy=multi-user.target
